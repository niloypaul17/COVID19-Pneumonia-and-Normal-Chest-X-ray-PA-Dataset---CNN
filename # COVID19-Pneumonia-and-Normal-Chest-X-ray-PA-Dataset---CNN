      "source": [
        "# ============================================================\n",
        "# 4. STRATIFIED 80/20 TRAIN-VALIDATION SPLIT\n",
        "# ============================================================\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "# Load the whole dataset once (transform will be attached in the next section).\n",
        "# ImageFolder gives every image an integer label based on its folder name.\n",
        "full_ds_for_split = datasets.ImageFolder(DATA_DIR)\n",
        "targets = [label for _, label in full_ds_for_split.samples]   # the label of every image\n",
        "\n",
        "# Stratified split of the INDICES (not the images themselves):\n",
        "# 80% of each class goes to training, 20% of each class to validation.\n",
        "train_idx, val_idx = train_test_split(\n",
        "    range(len(targets)),\n",
        "    test_size=0.20,          # 20% for validation\n",
        "    stratify=targets,        # keep class balance identical in both sets\n",
        "    random_state=42,         # reproducible split\n",
        ")\n",
        "\n",
        "print(\"Class names        :\", full_ds_for_split.classes)\n",
        "print(\"Training images    :\", len(train_idx))\n",
        "print(\"Validation images  :\", len(val_idx))\n"
